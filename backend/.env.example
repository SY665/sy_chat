APP_ENV=development
SERVER_PORT=8080
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_DSN=sy_chat:sy_chat_dev_password@tcp(127.0.0.1:3306)/sy_chat?charset=utf8mb4&parseTime=True&loc=Local
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_EXPIRES_IN=168h
COOKIE_SECURE=false
# local 不调用外部服务；siliconflow 使用真实模型。
AI_PROVIDER=local

SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODELS=Pro/zai-org/GLM-5.1,moonshotai/Kimi-K2.7-Code
AI_REQUEST_TIMEOUT=60s
# 默认模型必须包含在可选列表中；多个模型使用英文逗号分隔。
SILICONFLOW_MODELS=Pro/zai-org/GLM-5.1
# 仅填写能够返回独立推理内容的模型，多个模型使用英文逗号分隔。
SILICONFLOW_THINKING_MODELS=moonshotai/Kimi-K2.7-Code
TAVILY_API_KEY=你的_Tavily_API_Key
TAVILY_SEARCH_URL=https://api.tavily.com/search
WEB_SEARCH_TIMEOUT=10s